def tong_hop_sinh_vien() -> dict :
    danh_sach_bang_cap = {"Excellent": 0, "Good": 0, "Pass": 0, "Fail": 0}
    for student in students :
        danh_sach_bang_cap[student['classification']] += 1
    return danh_sach_bang_cap

def avg_subject() -> list :
    help_student = []
    min_avg_subject = ''
    avg_score = {}
    subjects = list(students[0]['scores'].keys())
    for subject in subjects :
        total_score = sum(student['scores'][subject] for student in students)
        avg_score[subject] = total_score / len(students)
    min_avg_subject = min(avg_score, key = avg_score.get)
    for student in students :
        if student['scores'][min_avg_subject] < avg_score[min_avg_subject] :
            help_student.append(student)
    return help_student
def update_status(id: str, subject : str, new_score = 11) -> None :
    for student in students :
        if student['id'] == id :
            for sub1 in student['scores'] : 
                if sub1 == subject :
                    if new_score >= 0 and new_score <= 10 :
                        student['scores'][subject] = new_score
                        print(f"Successfully update student {id}")
                        return
                    print(f"Score {new_score} Error")
                    return
            print(f"Subject {subject} not found")
            return
    print(f"Student ID {id} not found")
def ranked () -> None :
    rank = 1
    count = 0
    for i in range(len(students)) :
        swapped = False
        for j in range(len(students) - 1) :
            if students[j]['average'] < students[j + 1]['average'] :
                students[j], students[j + 1] = students[j + 1], students[j]
                swapped = True
    current = students[0]['average']
    students[0]["Rank"] = rank
    for student in students[1::] :
        if student['average'] < current :
            rank = rank + 1 + count
            count = 0
            student["Rank"] = rank
            current = student['average']
        else :
            count += 1
            student["Rank"] = rank

