def calculate_average(id : str) -> float :
    sum_ = 0
    count = 0
    for student in students :
        if student['id'] == id :
            for score in student['scores'].values() :
                sum_ += score
                count += 1
    return sum_ / count if count > 0 else 0

def classification (id : str) -> str :
    score_list = []
    for student in students :
        if student['id'] == id :
            score_list.extend(student['scores'].values())
    avg = calculate_average(id)
    if avg >= 8 and len([x for x in score_list if x < 5]) == 0  :
        return "Excellent"
    elif avg >= 6.5 and len([x for x in score_list if x < 5]) == 0 :
        return "Good"
    elif avg >= 5.0 and len([x for x in score_list if x < 5]) == 0 :
        return "Pass"
    else :
        return "Fail"
def add_avg_classfication() -> None :
    for student in students :
        student['average'] = calculate_average(student['id'])
        student['classification'] = classification(student['id'])
